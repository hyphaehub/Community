{
  "expo": {
    "name": "HyphaeHub",
    "slug": "hyphaehub",
    "owner": "bikeidaho",
    "version": "0.1.0",
    "scheme": "hyphaehub",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyphaehub.app"
    },
    "android": {
      "package": "com.hyphaehub.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "829cbe13-e255-4f73-a312-e2084e4f1fa7"
      }
    }
  }
}
