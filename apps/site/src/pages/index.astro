---
import Base from '../layouts/Base.astro';

const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.hyphaehub.io';

const steps = [
  { n: '1', title: 'Source', body: 'Start from a spore syringe, liquid culture, agar, or clone.' },
  { n: '2', title: 'Grain jars', body: 'Split one source into several colonized grain jars.' },
  { n: '3', title: 'Tubs', body: 'Combine one or two jars into a fruiting tub. The lineage is kept.' },
  { n: '4', title: 'Harvest', body: 'Log each flush: wet weight, then dry weight after drying.' },
  { n: '5', title: 'Store', body: 'Prep, dry, and store. Each batch shows its cost per gram.' },
];

const features = [
  {
    title: 'Lineage graph',
    body: 'Every jar and tub is a node. See exactly which source became which harvest.',
  },
  {
    title: 'Cost per batch',
    body: 'Materials, substrate, and supplies roll up into true cost-per-dry-gram.',
  },
  {
    title: 'Yield & efficiency',
    body: 'Wet/dry ratios and biological efficiency computed automatically.',
  },
  {
    title: 'Contamination tracking',
    body: 'Flag contam early and keep it out of your lineage and your stats.',
  },
  {
    title: 'Strain library',
    body: 'Built-in catalog of common gourmet & functional cultivars, plus your own.',
  },
  {
    title: 'Works offline & self-hosted',
    body: 'Run the free Community Edition on your own hardware, forever.',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-2 md:py-24">
      <div>
        <span class="inline-flex items-center rounded-full bg-hyphae-100 px-3 py-1 text-xs font-semibold text-hyphae-800">
          Community · Cloud · Mobile
        </span>
        <h1 class="mt-4 text-4xl font-extrabold leading-tight tracking-tight text-substrate md:text-5xl">
          Track every thread of your grow.
        </h1>
        <p class="mt-4 max-w-md text-lg text-ink/70">
          HyphaeHub follows how you actually grow. One source becomes grain jars, jars go into
          fruiting tubs, and every batch keeps its real cost and yield.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={APP_URL}
            class="rounded-xl bg-hyphae-600 px-6 py-3 text-sm font-semibold text-spore shadow-sm transition-colors hover:bg-hyphae-700"
          >
            Start free
          </a>
          <a
            href="/self-host"
            class="rounded-xl border border-mycelium bg-white px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-spore"
          >
            Self-host it
          </a>
        </div>
        <p class="mt-4 text-xs text-ink/50">Free tier, no card required. Self-hosting is free forever.</p>
      </div>

      <!-- Lifecycle diagram -->
      <div class="rounded-3xl border border-mycelium bg-parchment p-6 shadow-sm">
        <div class="space-y-3">
          {steps.map((s) => (
            <div class="flex items-center gap-4 rounded-2xl border border-mycelium bg-white p-4">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-hyphae-600 text-sm font-bold text-spore">
                {s.n}
              </div>
              <div>
                <div class="font-semibold text-substrate">{s.title}</div>
                <div class="text-sm text-ink/60">{s.body}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- How it works band -->
  <section class="border-y border-mycelium bg-white/60">
    <div class="mx-auto max-w-6xl px-5 py-14">
      <h2 class="text-center text-2xl font-bold text-substrate">The whole lifecycle, in one place</h2>
      <p class="mx-auto mt-2 max-w-2xl text-center text-ink/60">
        Track your grow as it happens. Splitting and combining are built in, so your data matches
        what is on your shelf.
      </p>
      <div class="mt-10 flex flex-wrap items-stretch justify-center gap-3">
        {steps.map((s, i) => (
          <>
            <div class="w-40 rounded-2xl border border-mycelium bg-parchment p-4 text-center">
              <div class="text-xs font-semibold uppercase tracking-wide text-flush">Step {s.n}</div>
              <div class="mt-1 font-semibold text-substrate">{s.title}</div>
              <div class="mt-1 text-xs text-ink/60">{s.body}</div>
            </div>
            {i < steps.length - 1 && <div class="hidden self-center text-2xl text-hyphae-400 md:block">→</div>}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="text-2xl font-bold text-substrate">Built for cultivators</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="rounded-2xl border border-mycelium bg-white p-6">
          <h3 class="font-semibold text-substrate">{f.title}</h3>
          <p class="mt-2 text-sm text-ink/60">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Editions -->
  <section class="border-t border-mycelium bg-white/60">
    <div class="mx-auto grid max-w-6xl gap-6 px-5 py-16 md:grid-cols-3">
      <div class="rounded-2xl border border-mycelium bg-parchment p-6">
        <h3 class="font-semibold text-substrate">Community</h3>
        <p class="mt-2 text-sm text-ink/60">Free, open-source, self-hosted with Docker. Your data on your hardware.</p>
        <a href="/self-host" class="mt-4 inline-block text-sm font-semibold text-hyphae-700 hover:underline">Get started →</a>
      </div>
      <div class="rounded-2xl border border-hyphae-300 bg-white p-6 ring-1 ring-hyphae-200">
        <h3 class="font-semibold text-substrate">Cloud</h3>
        <p class="mt-2 text-sm text-ink/60">Hosted for you on Cloudflare. Start free, upgrade as you scale.</p>
        <a href="/pricing" class="mt-4 inline-block text-sm font-semibold text-hyphae-700 hover:underline">See pricing →</a>
      </div>
      <div class="rounded-2xl border border-mycelium bg-parchment p-6">
        <h3 class="font-semibold text-substrate">Mobile</h3>
        <p class="mt-2 text-sm text-ink/60">Log inoculations, colonization, and harvests from the grow room.</p>
        <span class="mt-4 inline-block text-sm font-semibold text-ink/40">Coming soon</span>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-5 py-20 text-center">
    <h2 class="text-3xl font-bold text-substrate">Ready to track your next flush?</h2>
    <p class="mx-auto mt-3 max-w-lg text-ink/60">
      Create a free account, or self-host the Community Edition today.
    </p>
    <div class="mt-7 flex justify-center gap-3">
      <a href={APP_URL} class="rounded-xl bg-hyphae-600 px-6 py-3 text-sm font-semibold text-spore hover:bg-hyphae-700">
        Start free
      </a>
      <a href="/docs" class="rounded-xl border border-mycelium bg-white px-6 py-3 text-sm font-semibold text-ink hover:bg-spore">
        Read the docs
      </a>
    </div>
  </section>
</Base>
