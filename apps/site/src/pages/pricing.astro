---
import { PLANS, PLAN_LIMITS } from '@hyphaehub/core';
import Base from '../layouts/Base.astro';

const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.hyphaehub.com';

function line(v: number | null, noun: string) {
  return v == null ? `Unlimited ${noun}` : `${v} ${noun}`;
}

const cards = PLANS.map((p) => {
  const l = PLAN_LIMITS[p];
  return {
    id: p,
    label: l.label,
    price: l.priceMonthlyUsd,
    featured: p === 'PRO',
    features: [
      line(l.maxActiveBatches, 'active batches'),
      line(l.maxCultures, 'cultures'),
      line(l.maxPhotos, 'photos'),
      `${l.maxMembers} team member${l.maxMembers > 1 ? 's' : ''}`,
      l.cloudSync ? 'Cloud sync for self-hosted' : 'Local tracking',
      l.analytics ? 'Analytics + CSV/PDF export' : 'Core tracking',
    ],
  };
});
---

<Base title="Pricing · HyphaeHub">
  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight text-substrate">Simple, honest pricing</h1>
      <p class="mx-auto mt-3 max-w-xl text-ink/60">
        Start free. Upgrade when your grow does. Or self-host the community edition for free,
        forever.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {cards.map((c) => (
        <div
          class={`rounded-3xl border bg-white p-7 ${
            c.featured ? 'border-hyphae-400 ring-2 ring-hyphae-200' : 'border-mycelium'
          }`}
        >
          {c.featured && (
            <div class="mb-3 inline-flex rounded-full bg-hyphae-100 px-3 py-1 text-xs font-semibold text-hyphae-800">
              Most popular
            </div>
          )}
          <h2 class="text-lg font-bold text-substrate">{c.label}</h2>
          <div class="mt-2">
            <span class="text-4xl font-extrabold text-substrate">${c.price}</span>
            <span class="text-ink/50">/mo</span>
          </div>
          <ul class="mt-6 space-y-2 text-sm text-ink/70">
            {c.features.map((f) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-hyphae-600">✓</span>
                {f}
              </li>
            ))}
          </ul>
          <a
            href={APP_URL}
            class={`mt-7 block rounded-xl px-4 py-3 text-center text-sm font-semibold transition-colors ${
              c.featured
                ? 'bg-hyphae-600 text-spore hover:bg-hyphae-700'
                : 'border border-mycelium bg-white text-ink hover:bg-spore'
            }`}
          >
            {c.price === 0 ? 'Start free' : `Choose ${c.label}`}
          </a>
        </div>
      ))}
    </div>

    <div class="mt-12 rounded-2xl border border-mycelium bg-parchment p-6 text-center">
      <h3 class="font-semibold text-substrate">Prefer to own your data?</h3>
      <p class="mx-auto mt-1 max-w-lg text-sm text-ink/60">
        The Community Edition has the full lifecycle tracker and is free to self-host with Docker.
      </p>
      <a href="/self-host" class="mt-3 inline-block text-sm font-semibold text-hyphae-700 hover:underline">
        See self-hosting →
      </a>
    </div>
  </section>
</Base>
