---
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---
<a href="/" class="flex items-center gap-2">
  <svg width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <rect width="64" height="64" rx="15" fill="#6B8E4E"></rect>
    <g stroke="#F6F2EA" stroke-width="5" stroke-linecap="round">
      <path d="M20 16 V48"></path><path d="M44 16 V48"></path><path d="M20 32 H44"></path>
    </g>
    <g fill="#F6F2EA">
      <circle cx="20" cy="16" r="4.4"></circle><circle cx="44" cy="16" r="4.4"></circle>
      <circle cx="20" cy="48" r="4.4"></circle><circle cx="44" cy="48" r="4.4"></circle><circle cx="32" cy="32" r="4"></circle>
    </g>
    <g stroke="#C77D4A" stroke-width="2.6" stroke-linecap="round">
      <path d="M32 32 l7 -6"></path><path d="M32 32 l-7 6"></path>
    </g>
    <g fill="#C77D4A"><circle cx="40" cy="25" r="2.4"></circle><circle cx="24" cy="39" r="2.4"></circle></g>
  </svg>
  <span class="text-xl font-bold tracking-tight text-substrate">Hyphae<span class="text-hyphae-600">Hub</span></span>
</a>
