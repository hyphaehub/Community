---
import Logo from '../components/Logo.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'HyphaeHub · Mushroom cultivation tracking',
  description = 'Track your whole mushroom grow, from a single source to grain jars, tubs, harvest, and cost per batch. Self-host for free, or run it in the cloud.',
} = Astro.props;

const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.hyphaehub.io';

const navLinks = [
  { href: '/pricing', label: 'Pricing' },
  { href: '/self-host', label: 'Self-host' },
  { href: '/docs', label: 'Docs' },
  { href: '/faq', label: 'FAQ' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#6B8E4E" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-40 border-b border-mycelium bg-spore/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
        <Logo />
        <nav class="hidden items-center gap-7 md:flex">
          {navLinks.map((l) => (
            <a href={l.href} class="text-sm font-medium text-ink/70 transition-colors hover:text-hyphae-700">
              {l.label}
            </a>
          ))}
          <a href={APP_URL} class="text-sm font-medium text-ink/70 hover:text-hyphae-700">Sign in</a>
          <a
            href={APP_URL}
            class="rounded-lg bg-hyphae-600 px-4 py-2 text-sm font-semibold text-spore transition-colors hover:bg-hyphae-700"
          >
            Open app
          </a>
        </nav>
        <a href={APP_URL} class="rounded-lg bg-hyphae-600 px-4 py-2 text-sm font-semibold text-spore md:hidden">
          Open app
        </a>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-mycelium bg-parchment">
      <div class="mx-auto max-w-6xl px-5 py-10">
        <div class="flex flex-col justify-between gap-6 md:flex-row">
          <div class="max-w-xs">
            <Logo size={26} />
            <p class="mt-3 text-sm text-ink/60">Track every thread of your grow.</p>
          </div>
          <div class="flex flex-wrap gap-12 text-sm">
            <div>
              <div class="mb-2 font-semibold text-substrate">Product</div>
              <ul class="space-y-1.5 text-ink/60">
                <li><a class="hover:text-hyphae-700" href="/pricing">Pricing</a></li>
                <li><a class="hover:text-hyphae-700" href="/self-host">Self-host</a></li>
                <li><a class="hover:text-hyphae-700" href="/docs">Docs</a></li>
                <li><a class="hover:text-hyphae-700" href={APP_URL}>Open app</a></li>
              </ul>
            </div>
            <div>
              <div class="mb-2 font-semibold text-substrate">Company</div>
              <ul class="space-y-1.5 text-ink/60">
                <li><a class="hover:text-hyphae-700" href="/faq">FAQ</a></li>
                <li><a class="hover:text-hyphae-700" href="/contact">Contact</a></li>
              </ul>
            </div>
            <div>
              <div class="mb-2 font-semibold text-substrate">Legal</div>
              <ul class="space-y-1.5 text-ink/60">
                <li><a class="hover:text-hyphae-700" href="/privacy">Privacy</a></li>
                <li><a class="hover:text-hyphae-700" href="/terms">Terms &amp; Usage</a></li>
                <li><a class="hover:text-hyphae-700" href="/legal">Responsible use</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-8 border-t border-mycelium pt-6 text-xs text-ink/50">
          <p>© {new Date().getFullYear()} HyphaeHub LLC. Community Edition is MIT-licensed.</p>
          <p class="mt-1">
            HyphaeHub is species-agnostic and provided for record-keeping only. You are
            responsible for complying with all laws that apply to what you cultivate in your
            jurisdiction.
          </p>
          <p class="mt-3" data-built-by="Dothmen Tech">
            Built by
            <a
              class="font-medium text-hyphae-700 hover:underline"
              href="https://www.dothmen.com"
              target="_blank"
              rel="noopener noreferrer"
            >
              Dothmen Tech
            </a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
