# HyphaeHub Community Edition — HTTPS reverse proxy.
#
# HYPHAEHUB_DOMAIN is your public hostname. Caddy automatically obtains and
# renews a Let's Encrypt certificate for it (ports 80 + 443 must reach this host
# and DNS must point at it). For a purely local test, leave it as "localhost"
# and Caddy serves HTTPS with its built-in internal CA (no ACME, no DNS).
{$HYPHAEHUB_DOMAIN:localhost} {
	reverse_proxy hyphaehub:8080
	encode zstd gzip
	header {
		# HTTPS is terminated here; tell browsers to stick to it.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
