{
  "name": "hyphaehub",
  "version": "0.1.0",
  "private": true,
  "description": "HyphaeHub — mushroom cultivation lifecycle & cost tracking. Community, cloud, and mobile.",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "sync:mobile": "node scripts/sync-standalone-mobile.mjs",
    "e2e:selfhost": "node scripts/e2e-selfhost.mjs",
    "e2e:transfer": "node scripts/e2e-transfer.mjs",
    "e2e:connect-admin": "node scripts/e2e-connect-admin.mjs",
    "e2e:telemetry": "node scripts/e2e-telemetry.mjs",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
